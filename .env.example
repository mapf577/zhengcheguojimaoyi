PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
TOKEN_SECRET=change-this-random-secret
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
SESSION_TTL_MS=86400000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCK_MS=900000
AI_PROVIDER=deepseek
AI_CHAT_RATE_LIMIT_WINDOW_MS=60000
AI_CHAT_RATE_LIMIT_MAX_REQUESTS=20
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_MAX_TOKENS=800

# AI lead discovery crawler. Use internal for built-in light crawling, or endpoint for an external crawler service.
CRAWLER_PROVIDER=internal
CRAWLER_ENDPOINT=
CRAWLER_MAX_RESULTS=6
CRAWLER_TIMEOUT_MS=10000
CRAWLER_USER_AGENT=GlobalThreadsLeadDiscovery/1.0

# Storage: json or mysql. Use mysql for production.
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vehicle_export
MYSQL_USER=vehicle_export
MYSQL_PASSWORD=change-this-mysql-password

# Optional: Alibaba Cloud OSS image uploads.
OSS_ENABLED=false
OSS_BUCKET=qichechukou
OSS_REGION=oss-ap-southeast-1
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://qichechukou.oss-ap-southeast-1.aliyuncs.com
OSS_UPLOAD_PREFIX=uploads/
OSS_PUBLIC_READ=false
OSS_SIGNED_URL_TTL_SECONDS=3600
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
